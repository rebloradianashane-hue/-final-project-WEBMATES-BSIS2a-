{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Launch AtudTA in Chrome",
            "url": "http://127.0.0.1:8080/index.html",
            "webRoot": "${workspaceFolder}",
